---
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { CONTACT } from "@/lib/data";
import { pageGraph } from "@/lib/schema";

// TODO(owner): have this reviewed by your legal adviser before relying on it.
const updated = "12 October 2026";
const title = "Terms and Conditions";
const description = "Terms for using the Media 360 Concept website. Project work is governed by the written proposal or agreement for each engagement.";
const crumbs = [{ name: "Home", path: "/" }, { name: "Terms", path: "/terms" }];
---

<Base title={title} description={description} ogSlug="home" schema={pageGraph({ path: "/terms", title, description, crumbs })}>
  <main id="main" class="mx-auto max-w-3xl px-6 pt-16 pb-24 md:pt-24">
    <Breadcrumbs items={crumbs} />
    <h1 class="font-display text-5xl font-semibold tracking-tight">Terms and Conditions</h1>
    <p class="mt-4 text-sm text-dim">Last updated: {updated}</p>
    <div class="prose-dim mt-10 space-y-8">
      <section><h2 class="font-display text-2xl font-semibold text-white">Use of this website</h2><p class="mt-3">This website provides information about Media 360 Concept's services. Content is general information, not a binding offer, and may change without notice.</p></section>
      <section><h2 class="font-display text-2xl font-semibold text-white">Projects and pricing</h2><p class="mt-3">Every engagement is governed by a written proposal or agreement that sets out scope, deliverables, timelines, fees and payment terms. Where that agreement differs from this website, the agreement applies. Timelines and descriptions on this site are typical, not guaranteed.</p></section>
      <section><h2 class="font-display text-2xl font-semibold text-white">Results</h2><p class="mt-3">We do not guarantee specific search rankings, traffic, advertising results or inclusion in AI-generated answers, as these depend on third-party platforms and market conditions outside our control.</p></section>
      <section><h2 class="font-display text-2xl font-semibold text-white">Intellectual property</h2><p class="mt-3">Website content, design and branding belong to Media 360 Concept. Ownership of client deliverables transfers as set out in each project agreement, normally on full payment.</p></section>
      <section><h2 class="font-display text-2xl font-semibold text-white">Liability</h2><p class="mt-3">To the extent permitted by law, we are not liable for indirect losses arising from use of this website. Links to third-party sites are provided for convenience.</p></section>
      <section><h2 class="font-display text-2xl font-semibold text-white">Governing law</h2><p class="mt-3">These terms are governed by the laws of India, with courts in Kozhikode, Kerala having jurisdiction. Questions: {CONTACT.email}.</p></section>
    </div>
  </main>
</Base>
