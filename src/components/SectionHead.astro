---
/** index/label are kept for call-site readability; the small label row is no longer rendered. */
interface Props { index?: string; label?: string; title: string; blurb?: string; as?: "h1" | "h2" }
const { title, blurb, as: Tag = "h2" } = Astro.props;
---

<div class="mb-14 md:mb-20">
  <Tag data-words class="max-w-5xl font-display text-[clamp(2.2rem,5.5vw,4.75rem)] leading-[1] font-semibold tracking-[-0.03em]">{title}</Tag>
  {blurb && <p data-reveal data-delay="0.15" class="mt-7 max-w-2xl text-lg leading-relaxed text-dim">{blurb}</p>}
</div>
