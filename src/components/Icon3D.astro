---
/**
 * Flat logo tile — pure CSS + inline SVG, so it costs no image requests
 * and stays sharp at any size. Shows either a real product logo (`brand`, from
 * brands.ts, on that brand's colours) or a simple symbol (`kind` + `tone`).
 * Decorative (aria-hidden).
 */
import type { IconKind, IconTone } from "@/lib/academy";
import { BRANDS, type BrandKey } from "@/lib/brands";
interface Props {
  brand?: BrandKey;
  kind?: IconKind;
  tone?: IconTone;
  /** Any CSS length, e.g. "4rem". */
  size?: string;
  float?: boolean;
  /** Animation offset so floating tiles don't move in sync, e.g. "-2s". */
  delay?: string;
  class?: string;
}
const { brand, kind = "spark", tone = "violet", size = "4rem", float = false, delay = "0s", class: cls } = Astro.props;
const b = brand ? BRANDS[brand] : undefined;
const vars = b ? `;--hi:${b.tile[0]};--mid:${b.tile[1]};--lo:${b.tile[2]};--edge:${b.tile[3]};--cast:${b.cast}${b.ring ? `;--ring:${b.ring}` : ""}` : "";
const gid = `py${Math.random().toString(36).slice(2, 9)}`;
---

<span class:list={["ico3d", !b && `tone-${tone}`, float && "ico3d-float", cls]} style={`--s:${size};--d:${delay}${vars}`} aria-hidden="true">
  {b?.glyph.type === "path" && (
    <svg viewBox={b.glyph.viewBox} class="ico-brand"><path d={b.glyph.d} fill={b.glyph.fill}></path></svg>
  )}
  {b?.glyph.type === "python" && (
    <svg viewBox={b.glyph.viewBox} class="ico-brand">
      <defs><linearGradient id={gid} x1="0" y1="0" x2="1" y2="1"><stop offset="0.5" stop-color="#5A9FD4"></stop><stop offset="0.5" stop-color="#FFD43B"></stop></linearGradient></defs>
      <path d={b.glyph.d} fill={`url(#${gid})`}></path>
    </svg>
  )}
  {b?.glyph.type === "figma" && (
    <svg viewBox="0 0 38 57" class="ico-figma">
      <path d="M19 28.5a9.5 9.5 0 1 1 19 0 9.5 9.5 0 0 1-19 0z" fill="#1ABCFE"></path>
      <path d="M0 47.5A9.5 9.5 0 0 1 9.5 38H19v9.5a9.5 9.5 0 1 1-19 0z" fill="#0ACF83"></path>
      <path d="M19 0v19h9.5a9.5 9.5 0 1 0 0-19H19z" fill="#FF7262"></path>
      <path d="M0 9.5A9.5 9.5 0 0 0 9.5 19H19V0H9.5A9.5 9.5 0 0 0 0 9.5z" fill="#F24E1E"></path>
      <path d="M0 28.5A9.5 9.5 0 0 0 9.5 38H19V19H9.5A9.5 9.5 0 0 0 0 28.5z" fill="#A259FF"></path>
    </svg>
  )}
  {b?.glyph.type === "letters" && <span class="ico-letters" style={`color:${b.glyph.fill}`}>{b.glyph.text}</span>}
  {!b && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    {kind === "stack" && <><path d="M12 3 3 7.5l9 4.5 9-4.5z"></path><path d="m3 12 9 4.5 9-4.5"></path><path d="m3 16.5 9 4.5 9-4.5"></path></>}
    {kind === "python" && <text x="12" y="16.4" text-anchor="middle" font-size="11.5" font-weight="700" fill="currentColor" stroke="none" font-family="Space Grotesk Variable, sans-serif">Py</text>}
    {kind === "server" && <><rect x="3" y="4" width="18" height="7" rx="2"></rect><rect x="3" y="13" width="18" height="7" rx="2"></rect><path d="M7 7.5h.01M7 16.5h.01"></path></>}
    {kind === "browser" && <><rect x="3" y="4" width="18" height="16" rx="2.5"></rect><path d="M3 9h18M7 6.5h.01M10 6.5h.01"></path></>}
    {kind === "globe" && <><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"></path></>}
    {kind === "spark" && <path d="M12 3l2.2 6.8L21 12l-6.8 2.2L12 21l-2.2-6.8L3 12l6.8-2.2z" fill="currentColor"></path>}
    {kind === "rocket" && <><path d="M14.5 4.5c3-1 5-1 5-1s0 2-1 5L13 14l-3-3z"></path><path d="M10 11 7 10l2-3 3 1M13 14l1 3-3 2-1-3M5 19c1-3 2.5-4.5 4-5"></path></>}
    {kind === "play" && <path d="M8 5v14l11-7z" fill="currentColor"></path>}
    {kind === "film" && <><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M7 4v16M17 4v16M3 9h4M3 15h4M17 9h4M17 15h4"></path></>}
    {kind === "motion" && <><path d="M4 18C8 18 9 6 13 6s5 6 7 6"></path><circle cx="4" cy="18" r="1.6" fill="currentColor"></circle><circle cx="20" cy="12" r="1.6" fill="currentColor"></circle></>}
    {kind === "wheel" && <><circle cx="12" cy="12" r="9"></circle><circle cx="12" cy="12" r="3"></circle><path d="M12 3v6M12 15v6M3 12h6M15 12h6"></path></>}
    {kind === "megaphone" && <><path d="M3 11v2a1 1 0 0 0 1 1h2l5 4V6L6 10H4a1 1 0 0 0-1 1z"></path><path d="M15 9a4 4 0 0 1 0 6M18 6a8 8 0 0 1 0 12"></path></>}
    {kind === "code" && <path d="m8 8-4 4 4 4M16 8l4 4-4 4M13.5 5l-3 14"></path>}
    {kind === "pen" && <><path d="M12 3 5 10l2 9h10l2-9z"></path><circle cx="12" cy="11.5" r="2"></circle><path d="M12 3v6.5"></path></>}
    {kind === "chart" && <><path d="m3 17 6-6 4 4 8-8"></path><path d="M15 7h6v6"></path></>}
    {kind === "wand" && <><path d="m4 20 11-11"></path><path d="m15 4 1-2 1 2 2 1-2 1-1 2-1-2-2-1z" fill="currentColor"></path><path d="M19 13v2M18 14h2M8 4v2M7 5h2"></path></>}
  </svg>
  )}
</span>
