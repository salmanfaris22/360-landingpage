---
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Button from "@/components/Button.astro";
import Icon3D from "@/components/Icon3D.astro";
import { CONTACT } from "@/lib/data";
import { ACADEMY, COURSES, TRACKS, BEST_COURSES as P, getCourse, type Course } from "@/lib/academy";
import { academyGraph, type Crumb } from "@/lib/schema";

const crumbs: Crumb[] = [
  { name: "Home", path: "/" },
  { name: "Academy", path: "/academy" },
  { name: P.name, path: P.path },
];
const schema = academyGraph({
  title: P.title,
  description: P.description,
  academyDescription: ACADEMY.description,
  courses: COURSES,
  faqs: P.faqs,
  crumbs,
  path: P.path,
  listName: "Courses at HiLITE Business Park, Calicut",
});
const picks = P.picks.map((p) => ({ who: p.who, course: getCourse(p.slug) as Course }));
const glance = [
  { k: "Courses", v: String(COURSES.length) },
  { k: "Mode", v: "Offline · Online" },
  { k: "Where", v: "HiLITE Business Park" },
  { k: "City", v: "Kozhikode (Calicut)" },
  { k: "Counselling", v: "Free on WhatsApp" },
];
---

<Base title={P.title} description={P.description} ogSlug={`academy-${P.slug}`} schema={schema} side="academy">
  <main id="main" class="mx-auto max-w-7xl px-6 pt-14 md:pt-20">
    <Breadcrumbs items={crumbs} />

    <header class="max-w-4xl">
      <h1 class="font-display text-[clamp(2.4rem,5.5vw,4.5rem)] leading-[1.02] font-bold tracking-[-0.035em]">{P.h1}</h1>
      <p class="mt-8 max-w-3xl text-lg leading-relaxed text-white/90" data-speakable>{P.answer}</p>
      <div class="mt-10 flex flex-wrap justify-center gap-4 sm:justify-start">
        <Button href={CONTACT.whatsappAcademy} external size="sm">Free counselling on WhatsApp</Button>
        <Button href="#courses" variant="ghost" size="sm">See all courses</Button>
      </div>
    </header>

    <dl class="card-ink mt-14 grid gap-px overflow-hidden bg-[var(--color-ink)] p-0 sm:grid-cols-2 lg:grid-cols-5">
      {glance.map((g) => (
        <div class="bg-[var(--color-surface)] p-6">
          <dt class="font-mono text-[11px] text-dim">{g.k}</dt>
          <dd class="mt-1 font-display text-lg font-semibold">{g.v}</dd>
        </div>
      ))}
    </dl>

    <div class="mt-20 space-y-20 md:mt-28 md:space-y-28">
      <section class="grid gap-8 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
        <h2 class="font-display text-3xl font-bold tracking-tight">Training inside HiLITE Business Park</h2>
        <div class="space-y-5 text-lg leading-relaxed">
          {P.intro.map((t) => <p>{t}</p>)}
        </div>
      </section>

      <section class="grid gap-8 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
        <h2 class="font-display text-3xl font-bold tracking-tight">How to judge the best course</h2>
        <ul class="grid gap-5 sm:grid-cols-2">
          {P.criteria.map((c) => (
            <li data-reveal class="card-ink p-6">
              <h3 class="font-display text-lg font-bold"><span class="hl">{c.title}</span></h3>
              <p class="mt-3 text-sm leading-relaxed text-dim">{c.text}</p>
            </li>
          ))}
        </ul>
      </section>

      <section id="courses" class="scroll-mt-24 space-y-12">
        <h2 class="font-display text-3xl font-bold tracking-tight">All courses at HiLITE Business Park</h2>
        {TRACKS.map((track) => (
          <div>
            <h3 class="font-display text-xl font-semibold"><span class={`tag-ink track-${track}`}>{track}</span></h3>
            <ul class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
              {COURSES.filter((c) => c.track === track).map((c) => (
                <li class="h-full">
                  <a href={`/academy/${c.slug}`} class="card-ink flex h-full flex-col p-6">
                    <div class="flex items-start justify-between gap-3">
                      <span class="tag-ink bg-[var(--color-surface)]">{c.level}</span>
                      <Icon3D {...c.icon} size="3rem" />
                    </div>
                    <span class="mt-4 font-display text-lg font-bold">{c.name}</span>
                    <span class="mt-2 text-sm leading-relaxed text-dim">{c.short}</span>
                    <span class="mt-auto pt-4 text-sm font-semibold">View course →</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>

      <section class="grid gap-8 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
        <h2 class="font-display text-3xl font-bold tracking-tight">Which course is best for you?</h2>
        <div class="overflow-x-auto">
          <table class="w-full border-y-2 border-[var(--color-ink)] text-left">
            <thead>
              <tr class="border-b-2 border-[var(--color-ink)] font-mono text-[11px] text-dim uppercase">
                <th scope="col" class="py-3 pr-4">If you are…</th>
                <th scope="col" class="py-3">Start with</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[var(--color-ink)]/20">
              {picks.map((p) => (
                <tr>
                  <td class="py-4 pr-4 leading-snug">{p.who}</td>
                  <td class="py-4"><a href={`/academy/${p.course.slug}`} class="link-underline font-display font-semibold">{p.course.keyword}</a></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="grid gap-8 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]" aria-labelledby="faq-heading">
        <h2 id="faq-heading" class="font-display text-3xl font-bold tracking-tight">Frequently asked questions</h2>
        <div class="divide-y-2 divide-[var(--color-ink)] border-y-2 border-[var(--color-ink)]">
          {P.faqs.map((f, i) => (
            <details class="group py-5" open={i === 0}>
              <summary class="flex cursor-pointer items-baseline justify-between gap-6 font-display text-lg font-medium">
                <h3>{f.q}</h3><span aria-hidden="true" class="text-cyan group-open:rotate-45">+</span>
              </summary>
              <p class="mt-4 max-w-2xl leading-relaxed text-dim">{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="term mb-24 p-10 text-center md:p-16">
        <h2 class="mx-auto max-w-2xl font-display text-3xl font-semibold tracking-tight md:text-4xl">Visit us at HiLITE Business Park</h2>
        <p class="mx-auto mt-4 max-w-xl text-[#f6f3ec]/70">{CONTACT.postal.street}, {CONTACT.postal.locality} {CONTACT.postal.postalCode}. Ask about the next batch, fees and the right course for you.</p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href={CONTACT.whatsappAcademy} target="_blank" rel="noopener" class="glow inline-flex min-h-[48px] items-center rounded-full bg-[#ffd23f] px-7 font-display font-semibold text-[#121212] hover:bg-[#ff6a3d]">WhatsApp {CONTACT.phoneDisplay}</a>
          <a href={CONTACT.mapUrl} target="_blank" rel="noopener" class="inline-flex min-h-[48px] items-center rounded-full border border-[#f6f3ec]/30 px-7 font-display font-semibold text-[#f6f3ec] hover:bg-[#f6f3ec] hover:text-[#121212]">Open in Google Maps</a>
        </div>
      </section>
    </div>
  </main>
</Base>
