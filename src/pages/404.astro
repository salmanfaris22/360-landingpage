---
import Base from "@/layouts/Base.astro";
---

<Base title="Page not found" description="This page doesn't exist. Find Media 360 Concept's services, about and contact pages here." noindex>
  <main id="main" class="mx-auto max-w-3xl px-6 py-32 text-center">
    <p class="label-mono">404</p>
    <h1 class="mt-6 font-display text-5xl font-semibold tracking-tight">This page doesn't exist.</h1>
    <p class="mt-6 text-lg text-dim">It may have moved. Try one of these instead:</p>
    <ul class="mt-8 flex flex-wrap justify-center gap-3">
      <li><a href="/" class="inline-block rounded-full border border-line px-5 py-2.5 hover:border-white/40">Home</a></li>
      <li><a href="/services" class="inline-block rounded-full border border-line px-5 py-2.5 hover:border-white/40">Services</a></li>
      <li><a href="/contact" class="inline-block rounded-full border border-line px-5 py-2.5 hover:border-white/40">Contact</a></li>
    </ul>
  </main>
</Base>
