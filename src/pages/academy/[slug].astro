---
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Button from "@/components/Button.astro";
import Icon3D from "@/components/Icon3D.astro";
import { CONTACT } from "@/lib/data";
import { ACADEMY, COURSES, getCourse, tintOf, CAREER_SUPPORT, type Course } from "@/lib/academy";
import { courseGraph, type Crumb } from "@/lib/schema";

export function getStaticPaths() {
  return COURSES.map((course) => ({ params: { slug: course.slug }, props: { course } }));
}

const { course } = Astro.props as { course: Course };
const path = `/academy/${course.slug}`;
const crumbs: Crumb[] = [
  { name: "Home", path: "/" },
  { name: "Academy", path: "/academy" },
  { name: course.name, path },
];
const related = course.related.map(getCourse).filter((c): c is Course => Boolean(c));
const schema = courseGraph({ course, title: course.title, description: course.description, academyDescription: ACADEMY.description, faqs: course.faqs, crumbs });
const glance = [
  { k: "Track", v: course.track },
  { k: "Level", v: course.level },
  { k: "Duration", v: course.duration ?? "Ask on WhatsApp" },
  { k: "Mode", v: "Offline at HiLITE · Live online" },
  { k: "Batches", v: "Sunday–Friday · Morning & evening" },
  { k: "Language", v: "Malayalam + English" },
];
const showWeeks = course.syllabus.some((r) => r.when);
// This course next to the ones students usually weigh it against.
const compare = [course, ...related];
---

<Base title={course.title} description={course.description} ogSlug={`academy-${course.slug}`} schema={schema} side="academy">
  <main id="main" class="mx-auto max-w-7xl px-6 pt-14 md:pt-20">
    <Breadcrumbs items={crumbs} />

    <header class="grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_auto]">
      <div class="max-w-4xl">
      <div class="flex flex-wrap items-center gap-2">
        <span class="lg:hidden"><Icon3D {...course.icon} size="3.5rem" float /></span>
        <span class={`tag-ink track-${course.track}`}>{course.track}</span>
        <span class="tag-ink bg-[var(--color-surface)]">{course.level}</span>
      </div>
      <h1 class="mt-6 font-display text-[clamp(2.4rem,5.5vw,4.5rem)] leading-[1.02] font-bold tracking-[-0.035em]">{course.h1}</h1>
      <p class="mt-8 max-w-3xl text-lg leading-relaxed text-white/90" data-speakable>{course.answer}</p>
      <div class="mt-10 flex flex-wrap justify-center gap-4 sm:justify-start">
        <Button href={CONTACT.whatsappAcademy} external size="sm">Free counselling on WhatsApp</Button>
        <Button href="#syllabus" variant="ghost" size="sm">See the syllabus</Button>
      </div>
      </div>
      <!-- 3D course mark: one big tile with a glow and an orbit -->
      <div class="course-art hidden lg:grid" aria-hidden="true" style={`--tint:${tintOf(course.icon)}`}>
        <span class="course-art-glow"></span>
        <svg class="absolute inset-0 h-full w-full" viewBox="0 0 280 280" fill="none"><ellipse cx="140" cy="170" rx="128" ry="40" stroke="rgb(18 18 18 / 26%)" stroke-width="1.2" stroke-dasharray="4 6"></ellipse></svg>
        <span class="relative"><Icon3D {...course.icon} size="9rem" float /></span>
      </div>
    </header>

    <dl class="card-ink mt-14 grid gap-px overflow-hidden bg-[var(--color-ink)] p-0 sm:grid-cols-2 lg:grid-cols-3">
      {glance.map((g) => (
        <div class="bg-[var(--color-surface)] p-6">
          <dt class="font-mono text-[11px] text-dim">{g.k}</dt>
          <dd class="mt-1 font-display text-lg font-semibold">{g.v}</dd>
        </div>
      ))}
    </dl>

    <div class="mt-20 space-y-20 md:mt-28 md:space-y-28">
      <section class="grid gap-8 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
        <h2 class="font-display text-3xl font-bold tracking-tight">About the {course.name} course</h2>
        <div class="max-w-3xl space-y-5 text-lg leading-relaxed">
          {course.overview.map((t) => <p>{t}</p>)}
        </div>
      </section>

      <section class="grid gap-8 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
        <h2 class="font-display text-3xl font-bold tracking-tight">Who this course is for</h2>
        <ul class="grid gap-4 sm:grid-cols-3">
          {course.forWho.map((w) => <li class="card-ink p-5 leading-relaxed">{w}</li>)}
        </ul>
      </section>

      <section id="syllabus" class="scroll-mt-24 grid gap-8 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
        <h2 class="font-display text-3xl font-bold tracking-tight">{course.name} syllabus</h2>
        <div class="table-wrap">
          <table class="data-table">
            <caption class="sr-only">{course.name} syllabus: modules, topics, tools and what you build</caption>
            <thead>
              <tr>
                <th scope="col">#</th>
                {showWeeks && <th scope="col">When</th>}
                <th scope="col">Module &amp; topics</th>
                <th scope="col">Tools</th>
                <th scope="col">What you build</th>
              </tr>
            </thead>
            <tbody>
              {course.modules.map((m, i) => (
                <tr>
                  <td class="num font-display text-2xl font-bold text-cyan">{String(i + 1).padStart(2, "0")}</td>
                  {showWeeks && <td data-label="When" class="whitespace-nowrap font-mono text-xs">{course.syllabus[i].when}</td>}
                  <td data-label="Module">
                    <h3 class="font-display text-lg font-semibold">{m.title}</h3>
                    <p class="mt-1 text-sm text-dim">{m.topics.join(" · ")}</p>
                  </td>
                  <td data-label="Tools" class="text-sm">{course.syllabus[i].tools}</td>
                  <td data-label="You build" class="text-sm font-medium">{course.syllabus[i].build}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="grid gap-8 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
        <h2 class="font-display text-3xl font-bold tracking-tight">Projects you'll build</h2>
        <ul class="grid gap-6 sm:grid-cols-3">
          {course.projects.map((p) => (
            <li data-reveal class="card-ink p-6">
              <h3 class="font-display text-lg font-bold"><span class="hl">{p.title}</span></h3>
              <p class="mt-3 text-sm leading-relaxed text-dim">{p.text}</p>
            </li>
          ))}
        </ul>
      </section>

      <section class="grid gap-8 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
        <h2 class="font-display text-3xl font-bold tracking-tight">Tools you'll use</h2>
        <ul class="flex flex-wrap gap-2.5">
          {course.tools.map((t) => <li class="tag-ink bg-[var(--color-surface)] text-[0.8125rem]">{t}</li>)}
        </ul>
      </section>

      <section class="grid gap-8 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
        <h2 class="font-display text-3xl font-bold tracking-tight">Careers after the {course.name} course</h2>
        <div class="space-y-6">
          <div class="table-wrap">
            <table class="data-table">
              <caption class="sr-only">Jobs after {course.name}: what you do, skills used and where you could work</caption>
              <thead>
                <tr><th scope="col">Job role</th><th scope="col">What you do</th><th scope="col">Skills used</th><th scope="col">Where you could work</th></tr>
              </thead>
              <tbody>
                {course.careerTable.map((r) => (
                  <tr>
                    <th scope="row" class="font-display font-semibold">{r.role}</th>
                    <td data-label="What you do" class="text-sm">{r.does}</td>
                    <td data-label="Skills" class="text-sm">{r.skills}</td>
                    <td data-label="Where" class="text-sm text-dim">{r.where}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <div class="card-ink p-6">
            <h3 class="font-display text-lg font-bold">Career support</h3>
            <ul class="mt-4 space-y-2 text-sm">
              {CAREER_SUPPORT.map((c) => <li class="flex gap-3"><span class="text-cyan" aria-hidden="true">✓</span>{c}</li>)}
            </ul>
          </div>
        </div>
      </section>

      <section class="grid gap-8 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
        <h2 class="font-display text-3xl font-bold tracking-tight">{course.name} vs. similar courses</h2>
        <div class="table-wrap">
          <table class="data-table">
            <caption class="sr-only">{course.name} compared with similar Media 360 Academy courses</caption>
            <thead>
              <tr><th scope="col">Course</th><th scope="col">Best for</th><th scope="col">Level</th><th scope="col">Main tools</th></tr>
            </thead>
            <tbody>
              {compare.map((c) => (
                <tr class:list={[c.slug === course.slug && "bg-[var(--color-hl)]/40"]}>
                  <th scope="row" class="font-display font-semibold">
                    {c.slug === course.slug ? c.name : <a href={`/academy/${c.slug}`} class="link-underline">{c.name}</a>}
                  </th>
                  <td data-label="Best for" class="text-sm">{c.bestFor}</td>
                  <td data-label="Level" class="text-sm">{c.level}</td>
                  <td data-label="Main tools" class="text-sm text-dim">{c.tools.slice(0, 4).join(", ")}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section id="visit" class="scroll-mt-24 grid gap-8 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
        <h2 class="font-display text-3xl font-bold tracking-tight">Batches &amp; visit</h2>
        <div class="grid gap-5 sm:grid-cols-2">
          <div class="card-ink p-6">
            <h3 class="font-display text-lg font-bold">Classroom at HiLITE Business Park</h3>
            <address class="mt-3 leading-relaxed not-italic">{CONTACT.postal.street}, {CONTACT.postal.locality}, {CONTACT.postal.region} {CONTACT.postal.postalCode}</address>
            <p class="mt-2 text-sm text-dim">Inside HiLITE City, next to HiLITE Mall on Thondayad Bypass, Kozhikode.</p>
            <a href={CONTACT.mapUrl} target="_blank" rel="noopener" class="link-underline mt-4 inline-block font-display font-semibold">Open in Google Maps →</a>
          </div>
          <div class="card-ink p-6">
            <h3 class="font-display text-lg font-bold">Batches</h3>
            <ul class="mt-3 space-y-2">
              <li class="flex gap-3"><span class="text-cyan" aria-hidden="true">✓</span>Sunday to Friday</li>
              <li class="flex gap-3"><span class="text-cyan" aria-hidden="true">✓</span>Morning and evening batches</li>
              <li class="flex gap-3"><span class="text-cyan" aria-hidden="true">✓</span>Offline at HiLITE or live online</li>
              <li class="flex gap-3"><span class="text-cyan" aria-hidden="true">✓</span>Taught in Malayalam and English</li>
            </ul>
            <a href={CONTACT.whatsappAcademy} target="_blank" rel="noopener" class="link-underline mt-4 inline-block font-display font-semibold">Ask for the next batch on WhatsApp →</a>
          </div>
        </div>
      </section>

      <section class="grid gap-8 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]" aria-labelledby="faq-heading">
        <h2 id="faq-heading" class="font-display text-3xl font-bold tracking-tight">Frequently asked questions</h2>
        <div class="divide-y-2 divide-[var(--color-ink)] border-y-2 border-[var(--color-ink)]">
          {course.faqs.map((f, i) => (
            <details class="group py-5" open={i === 0}>
              <summary class="flex cursor-pointer items-baseline justify-between gap-6 font-display text-lg font-medium">
                <h3>{f.q}</h3><span aria-hidden="true" class="text-cyan group-open:rotate-45">+</span>
              </summary>
              <p class="mt-4 max-w-2xl leading-relaxed text-dim">{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="grid gap-8 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
        <h2 class="font-display text-3xl font-bold tracking-tight">Related courses</h2>
        <ul class="grid gap-5 sm:grid-cols-3">
          {related.map((r) => (
            <li class="h-full">
              <a href={`/academy/${r.slug}`} class="card-ink flex h-full flex-col p-6">
                <div class="flex items-start justify-between gap-3">
                  <span class={`tag-ink track-${r.track}`}>{r.track}</span>
                  <Icon3D {...r.icon} size="3rem" />
                </div>
                <span class="mt-4 font-display text-lg font-bold">{r.keyword}</span>
                <span class="mt-auto pt-4 text-sm font-semibold">View →</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section class="term mb-24 p-10 text-center md:p-16">
        <h2 class="mx-auto max-w-2xl font-display text-3xl font-semibold tracking-tight md:text-4xl">Ready to start {course.name}?</h2>
        <p class="mx-auto mt-4 max-w-xl text-[#f6f3ec]/70">Ask about the next batch, fees and whether this is the right course for you.</p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a href={CONTACT.whatsappAcademy} target="_blank" rel="noopener" class="glow inline-flex min-h-[48px] items-center rounded-full bg-[#ffd23f] px-7 font-display font-semibold text-[#121212] hover:bg-[#ff6a3d]">WhatsApp {CONTACT.phoneDisplay}</a>
          <a href="/academy#courses" class="inline-flex min-h-[48px] items-center rounded-full border border-[#f6f3ec]/30 px-7 font-display font-semibold text-[#f6f3ec] hover:bg-[#f6f3ec] hover:text-[#121212]">All courses</a>
        </div>
      </section>
    </div>
  </main>
</Base>
