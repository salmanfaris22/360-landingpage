---
import { CONTACT } from "@/lib/data";
interface Props { heading?: string; text?: string }
const {
  heading = "Tell us what you're building — we'll reply within 24 hours.",
  text = "Message Media 360 Concept on WhatsApp, call, or email and get a clear, itemised plan for your project.",
} = Astro.props;
---

<section class="rounded-3xl border border-line p-8 text-center md:p-16">
  <p class="label-mono">Free consultation · HiLITE Business Park, Calicut</p>
  <h2 class="mx-auto mt-6 max-w-2xl font-display text-3xl font-semibold tracking-tight md:text-4xl">{heading}</h2>
  <p class="mx-auto mt-4 max-w-xl leading-relaxed text-dim">{text}</p>
  <div class="mt-8 flex flex-wrap justify-center gap-4">
    <a href={CONTACT.whatsapp} target="_blank" rel="noopener" class="inline-flex min-h-[48px] items-center rounded-full bg-white px-7 py-3 text-sm font-medium text-black hover:opacity-85">
      WhatsApp {CONTACT.phoneDisplay}
    </a>
    <a href="/contact" class="inline-flex min-h-[48px] items-center rounded-full border border-white/25 px-7 py-3 text-sm hover:border-white/60">
      Discuss your project
    </a>
  </div>
</section>
