---
import type { Crumb } from "@/lib/schema";
interface Props { items: Crumb[] }
const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mb-10">
  <ol class="flex flex-wrap items-center gap-2 font-mono text-[11px] tracking-[0.15em] text-dim uppercase">
    {
      items.map((item, i) => (
        <>
          {i > 0 && <li aria-hidden="true">/</li>}
          <li>
            {i < items.length - 1 ? (
              <a href={item.path} class="link-underline hover:text-white">{item.name}</a>
            ) : (
              <span aria-current="page" class="text-white/70">{item.name}</span>
            )}
          </li>
        </>
      ))
    }
  </ol>
</nav>
