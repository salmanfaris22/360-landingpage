---
import { NAV_LINKS, CONTACT } from "@/lib/data";
const path = Astro.url.pathname;
---

<header class="sticky top-0 z-[100] border-b border-line bg-base/90 backdrop-blur-md">
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4" aria-label="Main">
    <a href="/" class="flex items-baseline gap-2 font-display text-lg font-bold tracking-tight" aria-label="Media 360 Concept home">
      MEDIA 360
      <span class="inline-block h-2 w-2 rounded-full bg-gradient-to-r from-blue to-cyan" aria-hidden="true"></span>
      <span class="font-mono text-[10px] font-normal tracking-[0.3em] text-dim">CONCEPT</span>
    </a>

    <ul class="hidden items-center gap-8 lg:flex">
      {
        NAV_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={path === link.href ? "page" : undefined}
              class:list={["link-underline text-sm transition-colors hover:text-white", path === link.href ? "text-white" : "text-dim"]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a href="/contact" class="inline-flex min-h-[44px] items-center rounded-full border border-white/25 px-6 py-2.5 text-sm transition-colors hover:bg-white hover:text-black">
          Start a project
        </a>
      </li>
    </ul>

    <details class="menu lg:hidden">
      <summary class="flex h-11 w-11 cursor-pointer items-center justify-center" aria-label="Menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 8h18M3 16h18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>
      </summary>
      <div class="menu-panel fixed inset-x-0 top-[72px] hidden flex-col gap-1 border-b border-line bg-base px-6 pt-4 pb-8">
        {
          NAV_LINKS.map((link) => (
            <a href={link.href} class="py-3 font-display text-2xl font-semibold tracking-tight">
              {link.label}
            </a>
          ))
        }
        <a href={CONTACT.whatsapp} target="_blank" rel="noopener" class="mt-4 inline-flex min-h-[48px] items-center justify-center rounded-full bg-white px-6 text-sm font-medium text-black">
          WhatsApp {CONTACT.phoneDisplay}
        </a>
      </div>
    </details>
  </nav>
</header>
