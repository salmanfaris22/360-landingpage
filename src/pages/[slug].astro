---
import Base from "@/layouts/Base.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import CtaBlock from "@/components/CtaBlock.astro";
import Button from "@/components/Button.astro";
import { CONTACT } from "@/lib/data";
import { SEO_PAGES, getSeoPage, type SeoPage, type Cluster } from "@/lib/seo-pages";
import { servicePageGraph, type Crumb } from "@/lib/schema";

export function getStaticPaths() {
  return SEO_PAGES.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const HUBS: Record<Cluster, Crumb | null> = {
  marketing: { name: "Digital Marketing", path: "/digital-marketing-kozhikode" },
  web: { name: "Web Development", path: "/web-development-kozhikode" },
  software: { name: "Software & AI", path: "/software-development-company-kozhikode" },
  branding: { name: "Branding & Creative", path: "/branding-agency-kozhikode" },
  local: null,
};

const { page } = Astro.props as { page: SeoPage };
const path = `/${page.slug}`;
const hub = HUBS[page.cluster ?? "branding"];
const crumbs: Crumb[] = [
  { name: "Home", path: "/" },
  { name: "Services", path: "/services" },
  ...(hub && hub.path !== path ? [hub] : []),
  { name: page.serviceName, path },
];
const related = page.related.map(getSeoPage).filter((p): p is SeoPage => Boolean(p));
const schema = servicePageGraph({ ...page, crumbs });
---

<Base title={page.title} description={page.description} ogSlug={page.slug} schema={schema}>
  <main id="main" class="mx-auto max-w-7xl px-6 pt-16 pb-24 md:pt-24">
    <Breadcrumbs items={crumbs} />

    <header class="max-w-4xl">
      <p class="label-mono">{page.eyebrow}</p>
      <h1 class="mt-6 font-display text-[clamp(2.4rem,5.5vw,4.5rem)] leading-[1.04] font-semibold tracking-[-0.03em]">{page.h1}</h1>
      {
        page.answer && (
          <p class="mt-8 max-w-3xl border-l-2 border-cyan pl-5 text-lg leading-relaxed text-white/90" data-speakable>
            {page.answer}
          </p>
        )
      }
      {page.intro.map((p) => <p class="mt-6 max-w-3xl text-lg leading-relaxed text-dim">{p}</p>)}
      <div class="mt-10 flex flex-wrap gap-4">
        <Button href={CONTACT.whatsapp} external size="sm">Get a free consultation on WhatsApp</Button>
        <Button href="/contact" variant="ghost" size="sm">Get a project estimate</Button>
      </div>
    </header>

    <div class="mt-20 space-y-16 md:mt-28">
      {
        page.sections.map((section) => (
          <section data-reveal class="border-t border-line pt-12">
            <div class="grid gap-8 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
              <h2 class="font-display text-2xl font-semibold tracking-tight md:text-3xl">{section.heading}</h2>
              <div class="prose-dim">
                {section.body.map((p) => <p class="mb-5">{p}</p>)}
                {section.bullets && (
                  <dl class="mt-2 grid gap-5 sm:grid-cols-2">
                    {section.bullets.map((b) => (
                      <div data-tilt="5" class="rounded-2xl border border-line p-6 transition-colors hover:border-white/20">
                        <dt class="font-display text-base font-semibold">{b.title}</dt>
                        <dd class="mt-2 text-sm leading-relaxed text-dim">{b.text}</dd>
                      </div>
                    ))}
                  </dl>
                )}
              </div>
            </div>
          </section>
        ))
      }

      {
        page.steps && (
          <section data-reveal class="border-t border-line pt-12" aria-labelledby="process-heading">
            <div class="grid gap-8 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
              <h2 id="process-heading" class="font-display text-2xl font-semibold tracking-tight md:text-3xl">
                How it works
              </h2>
              <ol class="space-y-5">
                {page.steps.map((s, i) => (
                  <li class="grid grid-cols-[3rem_1fr] gap-4">
                    <span class="font-mono text-sm text-cyan">{String(i + 1).padStart(2, "0")}</span>
                    <div>
                      <h3 class="font-display text-lg font-semibold">{s.title}</h3>
                      <p class="mt-1 leading-relaxed text-dim">{s.text}</p>
                    </div>
                  </li>
                ))}
              </ol>
            </div>
          </section>
        )
      }

      {
        page.table && (
          <section data-reveal class="border-t border-line pt-12">
            <div class="grid gap-8 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
              <h2 class="font-display text-2xl font-semibold tracking-tight md:text-3xl">{page.table.caption}</h2>
              <div class="overflow-x-auto">
                <table class="data">
                  <thead>
                    <tr>{page.table.head.map((h) => <th scope="col">{h}</th>)}</tr>
                  </thead>
                  <tbody>
                    {page.table.rows.map(([first, ...rest]) => (
                      <tr>
                        <th scope="row">{first}</th>
                        {rest.map((c) => <td>{c}</td>)}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          </section>
        )
      }

      <section data-reveal class="border-t border-line pt-12">
        <div class="grid gap-8 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
          <h2 class="font-display text-2xl font-semibold tracking-tight md:text-3xl">What we deliver</h2>
          <ul class="flex flex-wrap gap-3">
            {page.deliverables.map((d) => <li class="rounded-full border border-line px-5 py-2 font-mono text-[11px] tracking-[0.15em] text-white/70 uppercase">{d}</li>)}
          </ul>
        </div>
      </section>

      <section data-reveal class="border-t border-line pt-12" aria-labelledby="faq-heading">
        <div class="grid gap-8 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
          <h2 id="faq-heading" class="font-display text-2xl font-semibold tracking-tight md:text-3xl">Frequently asked questions</h2>
          <div class="divide-y divide-line border-y border-line">
            {
              page.faqs.map((faq, i) => (
                <details class="group py-5" open={i === 0}>
                  <summary class="flex cursor-pointer items-baseline justify-between gap-6 font-display text-lg font-medium">
                    <h3>{faq.q}</h3>
                    <span aria-hidden="true" class="text-cyan group-open:rotate-45">+</span>
                  </summary>
                  <p class="mt-4 max-w-2xl leading-relaxed text-dim">{faq.a}</p>
                </details>
              ))
            }
          </div>
        </div>
      </section>

      <section data-reveal class="border-t border-line pt-12">
        <div class="grid gap-8 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
          <h2 class="font-display text-2xl font-semibold tracking-tight md:text-3xl">Related services</h2>
          <ul class="grid gap-4 sm:grid-cols-2">
            {
              related.map((rel) => (
                <li>
                  <a href={`/${rel.slug}`} class="group flex items-baseline justify-between gap-4 rounded-2xl border border-line p-6 hover:border-white/30">
                    <span class="font-display text-base font-semibold">{rel.keyword}</span>
                    <span aria-hidden="true" class="text-dim group-hover:text-cyan">→</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <CtaBlock />
    </div>
  </main>
</Base>
