---
interface Props { index: string; label: string; title: string; blurb?: string; as?: "h1" | "h2" }
const { index, label, title, blurb, as: Tag = "h2" } = Astro.props;
---

<div class="mb-14 md:mb-20">
  <div class="flex items-center gap-5">
    <span class="font-mono text-sm text-cyan">/{index}</span>
    <span class="label-mono">{label}</span>
    <span class="h-px flex-1 bg-line" aria-hidden="true"></span>
  </div>
  <Tag class="mt-8 max-w-5xl font-display text-[clamp(2.2rem,5.5vw,4.75rem)] leading-[1] font-semibold tracking-[-0.03em]">{title}</Tag>
  {blurb && <p class="mt-7 max-w-2xl text-lg leading-relaxed text-dim">{blurb}</p>}
</div>
