---
import { NAV_LINKS, CONTACT } from "@/lib/data";
import { ACADEMY_NAV } from "@/lib/academy";
interface Props { side?: "agency" | "academy" }
const { side = "agency" } = Astro.props;
const path = Astro.url.pathname;
const academy = side === "academy";
const links = academy ? ACADEMY_NAV : NAV_LINKS;
const cta = academy
  ? { label: "Free counselling", href: CONTACT.whatsappAcademy, external: true }
  : { label: "Start a project", href: "/contact", external: false };
---

<header class="sticky top-0 z-[100] border-b border-line bg-base/90 backdrop-blur-md">
  <nav class="mx-auto flex max-w-7xl items-center justify-between gap-3 px-6 py-4 sm:gap-4" aria-label="Main">
    <a href={academy ? "/academy" : "/agency"} class="flex shrink-0 items-baseline gap-2 font-display text-lg font-bold tracking-tight whitespace-nowrap" aria-label={academy ? "Media 360 Academy home" : "Media 360 Concept home"}>
      MEDIA 360
      <span class:list={["inline-block h-2 w-2 rounded-full", academy ? "bg-[var(--color-tang)]" : "bg-gradient-to-r from-blue to-cyan"]} aria-hidden="true"></span>
      <span class="hidden font-mono text-[10px] font-normal tracking-[0.3em] text-dim sm:inline">{academy ? "ACADEMY" : "CONCEPT"}</span>
    </a>

    <!-- Two sides of the brand: dark agency, light academy -->
    <div class="side-switch" role="group" aria-label="Choose a side">
      <a href="/agency" data-side-link="agency" aria-current={academy ? undefined : "true"}>Agency</a>
      <a href="/academy" data-side-link="academy" aria-current={academy ? "true" : undefined}>Academy</a>
    </div>

    <ul class="hidden items-center gap-7 xl:flex">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={path === link.href ? "page" : undefined}
              class:list={["link-underline text-sm transition-colors hover:text-white", path === link.href ? "text-white" : "text-dim"]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a
          href={cta.href}
          {...(cta.external ? { target: "_blank", rel: "noopener" } : {})}
          class="glow inline-flex min-h-[44px] items-center rounded-full border border-white/25 px-6 py-2.5 text-sm transition-colors hover:bg-white hover:text-black"
        >
          {cta.label}
        </a>
      </li>
    </ul>

    <details class="menu xl:hidden">
      <summary class="flex h-11 w-11 cursor-pointer items-center justify-center" aria-label="Menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 8h18M3 16h18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>
      </summary>
      <div class="menu-panel fixed inset-x-0 top-[72px] hidden flex-col gap-1 border-b border-line bg-base px-6 pt-4 pb-8">
        {
          links.map((link) => (
            <a href={link.href} class="py-3 font-display text-2xl font-semibold tracking-tight">
              {link.label}
            </a>
          ))
        }
        <a href={academy ? CONTACT.whatsappAcademy : CONTACT.whatsapp} target="_blank" rel="noopener" class="mt-4 inline-flex min-h-[48px] items-center justify-center rounded-full bg-white px-6 text-sm font-medium text-black">
          WhatsApp {CONTACT.phoneDisplay}
        </a>
      </div>
    </details>
  </nav>
</header>
